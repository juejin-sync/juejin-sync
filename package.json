{
  "name": "juejin-sync",
  "version": "1.4.2",
  "private": true,
  "description": "将掘金文章同步到多个内容平台（CSDN、微信公众号、博客园、知乎）的草稿箱",
  "homepage": "https://juejinsync.vercel.app/",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/juejin-sync/juejin-sync.git"
  },
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "build:release": "node build.mjs --release",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "dev": "node build.mjs --watch",
    "release:zip": "npm run check && npm test && npm run build:release && node scripts/package-release.mjs",
    "release:notes": "node scripts/extract-release-notes.mjs",
    "changelog:draft": "node scripts/draft-changelog.mjs"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/chrome": "^0.0.326",
    "@types/js-md5": "^0.8.0",
    "archiver": "^8.0.0",
    "esbuild": "^0.25.9",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "highlight.js": "^11.12.0",
    "js-md5": "^0.9.2",
    "marked": "^18.0.11",
    "mermaid": "^11.17.2"
  }
}
